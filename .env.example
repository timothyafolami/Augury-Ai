# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Everything here has a working default except the API key.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# groq | openai | anthropic | deepseek
AUGURY_PROVIDER=deepseek

# Groq serves both sizes of the open-weight gpt-oss family. Running the same
# evaluation on each is how we find out whether a result depends on model
# capability or on the architecture around it.
#
#   openai/gpt-oss-120b   default, stronger
#   openai/gpt-oss-20b    cheaper, for sweeps and for the capability comparison
#
# For the cross-provider robustness run, set AUGURY_PROVIDER and pick one of:
#   openai      gpt-4o | gpt-4o-mini
#   anthropic   claude-sonnet-4-5 | claude-haiku-4-5
#   deepseek    deepseek-v4-flash | deepseek-v4-pro | deepseek-v4-flash-vision-exp
#
# DeepSeek is OpenAI-compatible, so it needs no new client -- only a base URL
# and a price table. Its rates are recorded at PEAK: it bills half outside
# 01:00-04:00 and 06:00-10:00 UTC on weekdays, and a cost that is sometimes
# half what was reported is one nobody can plan against.
AUGURY_MODEL=deepseek-v4-flash

# A review should not vary run to run. Raise this only on purpose.
AUGURY_TEMPERATURE=0

# Output budget. gpt-oss reasons before it answers and spends this doing it,
# so too small a value fails with an empty generation rather than a short one.
AUGURY_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# Keys. Only the one matching AUGURY_PROVIDER is needed.
# ---------------------------------------------------------------------------

DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Replay
# ---------------------------------------------------------------------------

# Serve every model call from the committed cassettes and never reach the
# network. This is the path a judge takes: it reproduces every published number
# with no API key and no spend. `make eval-replay` sets it for you.
# AUGURY_REPLAY_ONLY=1

# Record every model call to the cassette directory as it happens, so the run
# can later be replayed. Needs a key and spends money. `make record` sets it.
# AUGURY_RECORD=1

# Where recordings live. Defaults to eval/cassettes inside this repository, so
# a clone has them. Set this only to keep a second set side by side.
# AUGURY_CASSETTES=
