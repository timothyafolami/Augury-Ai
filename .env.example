# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Everything here has a working default except the API key.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# groq | openai | anthropic
AUGURY_PROVIDER=groq

# Groq serves both sizes of the open-weight gpt-oss family. Running the same
# evaluation on each is how we find out whether a result depends on model
# capability or on the architecture around it.
#
#   openai/gpt-oss-120b   default, stronger
#   openai/gpt-oss-20b    cheaper, for sweeps and for the capability comparison
#
# For the cross-provider robustness run, set AUGURY_PROVIDER and pick one of:
#   openai      gpt-4o | gpt-4o-mini
#   anthropic   claude-sonnet-4-5 | claude-haiku-4-5
AUGURY_MODEL=openai/gpt-oss-120b

# A review should not vary run to run. Raise this only on purpose.
AUGURY_TEMPERATURE=0

# ---------------------------------------------------------------------------
# Keys. Only the one matching AUGURY_PROVIDER is needed.
# ---------------------------------------------------------------------------

GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Replay
# ---------------------------------------------------------------------------

# Serve every model call from the committed cassettes and never reach the
# network. This is the path a judge takes: it reproduces every published number
# with no API key and no spend. `make eval-replay` sets it for you.
# AUGURY_REPLAY_ONLY=1
